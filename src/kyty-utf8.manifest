<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The process's ANSI code page is UTF-8 (Windows 10 1903 and later): the command line, the C runtime's narrow file
     functions and narrow std::filesystem paths take every character, not only those of the system's code page (a user
     name with letters outside the code page of the system, such as Polish or Cyrillic ones on an English Windows). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
