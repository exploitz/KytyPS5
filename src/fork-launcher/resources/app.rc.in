// The Windows resources of KytyPS5 Launcher.exe: its icon and version information.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "KytyPS5"
			VALUE "FileDescription", "KytyPS5 Launcher"
			VALUE "FileVersion", "@kyty_launcher_version@"
			VALUE "InternalName", "KytyPS5 Launcher"
			VALUE "LegalCopyright", "GPL-3.0-or-later"
			VALUE "OriginalFilename", "KytyPS5 Launcher.exe"
			VALUE "ProductName", "KytyPS5 Launcher"
			VALUE "ProductVersion", "@kyty_launcher_version@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
